<Window x:Class="CookMaster1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CookMaster1.ViewModels"
        Title="CookMaster1 - Login"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Center card -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Width="420"
                HorizontalAlignment="Center">

            <StackPanel Width="360"
                        HorizontalAlignment="Center">

                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                    <Ellipse Width="44" Height="44"
                             Fill="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="CookMaster1"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                </StackPanel>

                <!-- Form heading -->
                <TextBlock Text="Sign in to your account"
                           Style="{StaticResource HeadingText}"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           Style="{StaticResource LabelText}" />

                <TextBox Style="{StaticResource AppTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Password -->
                <TextBlock Text="Password"
                           Style="{StaticResource LabelText}" />

                <PasswordBox x:Name="PwBox"
                             Style="{StaticResource AppPasswordBox}"
                             PasswordChanged="PwBox_PasswordChanged" />

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0">
                    <Button Content="Login"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}" />

                    <Button Content="Register"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenRegisterCommand}" />
                </StackPanel>

                <!-- Footer note -->
                <TextBlock Text="Forgot your password?"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
