<Window x:Class="CookMaster1.Views.RecipeListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CookMaster1.ViewModels"
        Title="Recipes" Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <!-- DataContext: create viewmodel instance for this view -->
    <Window.DataContext>
        <vm:RecipeListVM />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: controls + list -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="My Recipes" Style="{StaticResource HeadingText}" Margin="0,0,0,10"/>

                <!-- Search / filter (no PlaceholderText - use ToolTip instead) -->
                <TextBox Style="{StaticResource AppTextBox}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type to filter recipes by title" />

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Width="100"/>
                    <Button Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddRecipeCommand}" Width="100"/>
                    <Button Content="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveRecipeCommand}" Width="100"/>
                </StackPanel>

                <!-- Recipe list -->
                <ListBox ItemsSource="{Binding Recipes}"
                         SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                         DisplayMemberPath="Title"
                         Height="380" />
            </StackPanel>
        </Border>

        <!-- Right: details card -->
        <Border Style="{StaticResource Card}" Grid.Column="1">
            <StackPanel>
                <TextBlock Text="Recipe details" Style="{StaticResource HeadingText}" Margin="0,0,0,10"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Title" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding SelectedRecipe.Title, Mode=OneWay}" Style="{StaticResource AppTextBox}" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Category" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding SelectedRecipe.Category, Mode=OneWay}" Style="{StaticResource AppTextBox}" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Ingredients" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding SelectedRecipe.Ingredients, Mode=OneWay}" Style="{StaticResource AppTextBox}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Instructions" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding SelectedRecipe.Instructions, Mode=OneWay}" Style="{StaticResource AppTextBox}" Height="160" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Open Details" Style="{StaticResource PrimaryButton}" Command="{Binding OpenDetailsCommand}" />
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditRecipeCommand}" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
