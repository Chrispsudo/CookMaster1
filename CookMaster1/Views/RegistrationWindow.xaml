<Window x:Class="CookMaster1.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Width="380" HorizontalAlignment="Center">
            <StackPanel Width="340" HorizontalAlignment="Center">

                <TextBlock Text="Register new user"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           TextAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Username" Style="{StaticResource LabelText}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource AppTextBox}" />

                <TextBlock Text="Password" Style="{StaticResource LabelText}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}" />

                <TextBlock Text="Country" Style="{StaticResource LabelText}" />
                <TextBox x:Name="CountryBox" Style="{StaticResource AppTextBox}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="RegisterButton" Content="Register" Click="RegisterButton_Click"
                            Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
